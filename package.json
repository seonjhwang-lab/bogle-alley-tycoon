{
  "name": "bogle-bogle-alley-tycoon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview --host",
    "sprites": "python3 tools/gen_sprites.py",
    "fonts": "python3 tools/subset_fonts.py",
    "build:artifact": "tsc --noEmit && vite build --mode artifact && python3 tools/make_artifact.py"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "galmuri": "^2.40.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.0"
  }
}